# ---------------------------------------------------------------
# Copie este arquivo para .env.local e preencha com as suas chaves.
# NUNCA envie o .env.local para o GitHub.
# ---------------------------------------------------------------

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_service_role_key

# Etherscan (https://etherscan.io/myapikey) - rede Ethereum
ETHERSCAN_API_KEY=cole_aqui_a_chave_da_etherscan

# Helius (https://helius.dev) - rede Solana
HELIUS_API_KEY=cole_aqui_a_chave_da_helius

# Senha inventada por voce. Protege a rota que roda a coleta automatica.
CRON_SECRET=invente_uma_senha_longa_aqui
